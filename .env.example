# --- SMTP (server-side only, never exposed to the client) ---
# Spacemail defaults; adjust for your provider.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
# Authenticated mailbox that sends the mail. Also used as the From address.
SMTP_USER=contact@lamdix.com
# Password for the mailbox. NEVER commit a real value. Leave empty locally.
SMTP_PASS=
# Fixed recipient of contact form submissions.
MAIL_TO=contact@lamdix.com

# Canonical site URL (used for same-origin checks and SEO).
SITE_URL=https://lamdix.com

# --- Optional Cloudflare Turnstile (both must be set, or neither) ---
# If only one is set, the contact endpoint fails closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token
BING_SITE_VERIFICATION=
